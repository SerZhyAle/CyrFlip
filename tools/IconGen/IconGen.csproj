<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only asset generator. Not part of CyrFlip.sln. Run: dotnet run (from this folder). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>IconGen</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The layout palette, compiled rather than copied: the preview asset has to show the same
         colours the app draws, and a third hand-maintained table is exactly how it drifted before
         (IconGen knew only EN/RU/UK). LayoutStyle has no dependency beyond System.Drawing. -->
    <Compile Include="..\..\src\CyrFlip\LayoutStyle.cs" Link="LayoutStyle.cs" />
  </ItemGroup>

</Project>
