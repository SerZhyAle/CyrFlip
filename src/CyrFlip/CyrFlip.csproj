<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CyrFlip</RootNamespace>
    <AssemblyName>CyrFlip</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- ImplicitUsings is a .NET 6+ feature; keep usings explicit on net48. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\cyrflip.ico</ApplicationIcon>

    <!-- Treat a fixed set of "unused / unreachable / shadowing" warnings as errors
         (our cross-project convention). Nullable issues stay warnings, not errors. -->
    <WarningsAsErrors>CS0108;CS0162;CS0164;CS0168;CS0219;CS0414;CS0649;CS1998</WarningsAsErrors>

    <!-- Version is stamped at build time as YY.M.D.HHmm (e.g. 26.6.11.1627). -->
    <Version>$([System.DateTime]::Now.ToString('yy.M.d.HHmm'))</Version>
    <Company>SerZhyAle</Company>
    <Product>CyrFlip</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- net48 reference assemblies so the project builds with the .NET SDK alone,
         without a Visual Studio targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Let the test project exercise internal types (Hotkey, TransliterationEngine, ..). -->
    <InternalsVisibleTo Include="CyrFlip.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- JavaScriptSerializer (config.json parsing) lives here; framework assembly, no NuGet. -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <!-- HttpClient for the local Ollama translator; framework assembly on net48, but the SDK does
         not reference it implicitly, so `using System.Net.Http` needs this line. -->
    <Reference Include="System.Net.Http" />
    <!-- ZipFile/ZipArchive for the "send logs to the author" bundle; framework assembly on net48,
         but the SDK does not reference it implicitly. Still zero NuGet runtime deps. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- UI Automation - caret position fallback for apps without a system caret (CaretOverlay).
         Framework assemblies (ship with .NET on Win10/11), so still zero NuGet/runtime deps. -->
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- The absorbed OneClickRunner's own icon, embedded (no extra file to ship) and shown on the
         launcher's two surfaces: the settings page header and the taskbar button. LauncherBrand
         looks it up by this exact LogicalName. -->
    <EmbeddedResource Include="..\..\assets\oneclickrunner-source\app.ico" LogicalName="CyrFlip.launcher.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
