# Normalize line endings; let git handle text detection.
* text=auto

# Source files - CRLF (Windows / Visual Studio).
*.cs       text eol=crlf
*.csproj   text eol=crlf
*.sln      text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.manifest text eol=crlf
*.ps1      text eol=crlf

# Data / config.
*.json     text eol=crlf
*.yaml     text eol=crlf
*.yml      text eol=crlf
*.xml      text eol=crlf

# Web / docs.
*.html     text eol=crlf
*.css      text eol=crlf
# The vendored PAGE-STYLE kit is a byte copy of the catalog reference and is served as such: no EOL
# conversion, or GitHub Pages serves a CRLF copy that differs from the reference (a later line wins).
docs/assets/sza-kit.css -text
docs/help/sza-kit.css -text
*.md       text eol=crlf
*.txt      text eol=crlf

# TypeScript extension.
*.ts       text eol=crlf
*.js       text eol=crlf
*.vscodeignore text eol=crlf

# The contract's test vectors are a byte-exact copy of the catalog's: LF on every checkout, or the file-versus-parser test fails on a CRLF one.
tests/CyrFlip.Tests/Fixtures/InputChord/*.jsonl text eol=lf

# The settings-file writer emits LF (SettingsFileWriterTests asserts no CR), and BytesArePinnedByTheV1WriterFixture
# compares its output with this fixture's bytes: an eol=crlf checkout (the *.json rule above) fails it on a fresh clone.
tests/CyrFlip.Tests/Fixtures/SettingsFile/writer-v1.json text eol=lf
tests/CyrFlip.Tests/Fixtures/SettingsFile/writer-v2.json text eol=lf

# WINDOWS-STORE rules 8 and 13: the listing export, the emptied round-trip fixture and the built
# import CSV are compared as bytes - CRLF inside quoted cells included. Git must never normalise
# their line endings, or a fresh checkout no longer matches what Partner Center receives.
msix/store-listing-export.csv -text
msix/store-listing-export.sample.csv -text
msix/store-listing-import-13-languages.csv -text

# Binary assets.
*.ico  binary
*.png  binary
*.docx binary
*.vsix binary
# DEVICE-EXCHANGE vector copies are held by a SHA-256 of their bytes (ticket S0074): an eol=crlf checkout would change the bytes.
tests/CyrFlip.Tests/Fixtures/DeviceExchange/*.json text eol=lf
