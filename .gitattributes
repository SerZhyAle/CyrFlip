# Normalize line endings; let git handle text detection.
* text=auto

# Source files are CRLF (Windows / Visual Studio).
*.cs       text eol=crlf
*.csproj   text eol=crlf
*.sln      text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.manifest text eol=crlf
*.ps1      text eol=crlf
*.json     text eol=crlf
*.md       text

# Binary assets.
*.ico  binary
*.png  binary
*.docx binary
