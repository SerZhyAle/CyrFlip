# Normalize line endings; let git handle text detection.
* text=auto

# Source files - CRLF (Windows / Visual Studio).
*.cs       text eol=crlf
*.csproj   text eol=crlf
*.sln      text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.manifest text eol=crlf
*.ps1      text eol=crlf

# Data / config.
*.json     text eol=crlf
*.yaml     text eol=crlf
*.yml      text eol=crlf
*.xml      text eol=crlf

# Web / docs.
*.html     text eol=crlf
*.css      text eol=crlf
*.md       text eol=crlf
*.txt      text eol=crlf

# TypeScript extension.
*.ts       text eol=crlf
*.js       text eol=crlf
*.vscodeignore text eol=crlf

# Binary assets.
*.ico  binary
*.png  binary
*.docx binary
*.vsix binary
