{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // src/layout-colors.json is imported by extension.ts - the palette shared with the app.
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "out", ".vscode-test"]
}
