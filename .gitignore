# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
# ...but not the /release skill folder, which the build-output [Rr]elease/ rule above
# would otherwise silently swallow (it's source, not a build artifact).
!.claude/skills/release/
!.claude/skills/release/**

# Visual Studio
.vs/
*.user
*.suo
*.userprefs

# Release/packaging artifacts
dist/
stage/
*.sha256
*.msix
*.appx
*.cer
*.pfx

# Local scratch
temp/
# UI-test output (tools/uitest screenshots) - throwaway by design
artifacts/

# NuGet
*.nupkg
tools/nuget.exe

# OS noise
Thumbs.db
desktop.ini

# Store listing import staging - generated by msix/build-store-listing-csv.ps1 -ImportFolder from
# msix/screenshots + the export. The folder has to exist on disk (Partner Center asks you to select
# it) but it is a copy of tracked files, so it is not tracked itself.
msix/store-listing-import/
msix/listingData-*.csv

# Secrets and signing material - pre-empt the leak, never catch it afterwards.
*.snk
*.jks
*.keystore
.env
*token*
*secret*

# Stray agent-kit export - not produced by this repo and not read by it. It is an export of a
# generic agents/skills/rules pack from a different project, swept in by an accidental
# stage-everything in commit 72f30b9 ("1"). Nothing here references it, so a clone does not need it.
universal_agent_pack.zip
