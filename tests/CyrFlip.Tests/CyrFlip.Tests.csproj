<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CyrFlip\CyrFlip.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DialogLayoutTests builds the real dialogs to check nothing is clipped; the other tests
         reach the UI through reflection and need no reference of their own. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- SettingsTabAccessibilityTests reads AccessibleObject members whose interface lives here
         (the page list's TabItem objects, S0060 P4). -->
    <Reference Include="Accessibility" />
    <Reference Include="System.Web" />
    <!-- LayoutColorsTests parses the palette the VS Code extension ships, with the same JSON reader
         the app uses for its own config - no NuGet dependency on either side. -->
    <Reference Include="System.Web.Extensions" />
    <!-- SupportBundleTests opens the produced archive to check what did (and did not) go in. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- The source gates (LocalizationSourceGateTests) read string literals with the lexer of the migration tool,
         so a literal is found wherever it stands and the tool and the gate cannot disagree about what one is. -->
    <Compile Include="..\..\tools\l10n\CsLexer.cs" Link="Tools\CsLexer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Byte-exact OneClickRunner scenario XMLs (Р¤Р°Р·Р° 0) - the launcher migration fixtures. -->
    <None Update="Fixtures\**\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\SettingsFile\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
